{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/lab",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lab/abbonamenti",
      "destination": "/?sezione=abbonamenti",
      "permanent": false
    },
    {
      "source": "/lab/pagamenti",
      "destination": "/?sezione=pagamenti",
      "permanent": false
    },
    {
      "source": "/lab/profilo",
      "destination": "/?sezione=profilo",
      "permanent": false
    },
    {
      "source": "/lab/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/r/:percorso*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
