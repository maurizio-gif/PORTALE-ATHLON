{
  "expo": {
    "name": "Athlon Club",
    "slug": "portale-athlon-club",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "athlon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "associatedDomains": [
        "applinks:app.athlonroma.it"
      ],
      "bundleIdentifier": "com.netpulse.centrosportivoathlon",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF5701",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.athlonroma.it",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "it.athlonroma.app",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Athlon Club 4.0",
      "shortName": "Athlon Club 4.0",
      "themeColor": "#FF5701",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF5701",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#FF5701"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Athlon Club usa la fotocamera per scattare la foto del tuo profilo e per fotografare piani di allenamento, certificati e pasti.",
          "photosPermission": "Athlon Club legge una foto dalla tua libreria solo quando la scegli tu, per il profilo, i piani, i certificati e i pasti.",
          "microphonePermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Athlon Club legge da Apple Salute i tuoi passi, il sonno, il battito, la variabilità del battito, le calorie di movimento e gli allenamenti, solo se lo autorizzi, per mostrarli in Recover e in Train e calcolare il tuo Athlon Health Score.",
          "NSHealthUpdateUsageDescription": "Athlon Club non scrive nulla in Apple Salute: legge soltanto i tuoi dati, se lo autorizzi.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd484741-bae6-479f-98bc-0d7ee2bb41b2"
      }
    },
    "owner": "ready-2-digital",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dd484741-bae6-479f-98bc-0d7ee2bb41b2"
    }
  }
}
